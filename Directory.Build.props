<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Product>Kastom</Product>
    <Company>Kastom</Company>
    <SatelliteResourceLanguages>uk;en</SatelliteResourceLanguages>
    <!-- ThemeMode у WPF (тема Fluent) досі позначено як експериментальний. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
