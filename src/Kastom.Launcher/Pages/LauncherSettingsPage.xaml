<UserControl x:Class="Kastom.Launcher.Pages.LauncherSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Kastom.Launcher.Resources">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,10" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.NavLauncher}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

            <!-- Запуск -->
            <TextBlock Text="{x:Static res:Strings.SettingsStartupHeader}" Style="{StaticResource SectionHeader}" />
            <CheckBox x:Name="AutostartBox" Content="{x:Static res:Strings.SettingsAutostart}" Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />

            <!-- Вигляд -->
            <TextBlock Text="{x:Static res:Strings.SettingsAppearanceHeader}" Style="{StaticResource SectionHeader}" />
            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeSystem}"
                         Checked="OnThemeChanged" />
            <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeLight}"
                         Checked="OnThemeChanged" />
            <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeDark}"
                         Checked="OnThemeChanged" />

            <!-- Оновлення -->
            <TextBlock Text="{x:Static res:Strings.SettingsUpdatesHeader}" Style="{StaticResource SectionHeader}" />
            <RadioButton x:Name="ModeNotify" GroupName="UpdateMode" Content="{x:Static res:Strings.SettingsUpdateNotify}"
                         Checked="OnUpdateModeChanged" />
            <RadioButton x:Name="ModeAutomatic" GroupName="UpdateMode" Content="{x:Static res:Strings.SettingsUpdateAutomatic}"
                         Checked="OnUpdateModeChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CheckNowButton" Content="{x:Static res:Strings.SettingsCheckNow}"
                        Padding="16,8" Click="OnCheckNowClick" />
                <TextBlock x:Name="LastCheckText" Style="{StaticResource SecondaryText}"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="UpdateLauncherButton" Padding="16,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                    Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed"
                    Click="OnUpdateLauncherClick" />

            <!-- Панель задач -->
            <StackPanel x:Name="PinPanel" Visibility="Collapsed">
                <TextBlock Text="{x:Static res:Strings.SettingsTaskbarHeader}" Style="{StaticResource SectionHeader}" />
                <Button x:Name="PinButton" Content="{x:Static res:Strings.SettingsPin}"
                        Padding="16,8" HorizontalAlignment="Left" Click="OnPinClick" />
                <TextBlock Text="{x:Static res:Strings.SettingsPinNote}" Style="{StaticResource SecondaryText}"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Віджет -->
            <TextBlock Text="{x:Static res:Strings.SettingsWidgetHeader}" Style="{StaticResource SectionHeader}" />
            <CheckBox x:Name="WidgetBox" Content="{x:Static res:Strings.SettingsWidget}" Checked="OnWidgetChanged" Unchecked="OnWidgetChanged" />
            <CheckBox x:Name="DesktopLayerBox" Content="{x:Static res:Strings.SettingsWidgetsOnDesktop}"
                      Margin="0,8,0,0" Checked="OnDesktopLayerChanged" Unchecked="OnDesktopLayerChanged" />
            <TextBlock Text="{x:Static res:Strings.SettingsWidgetsOnDesktopNote}" Style="{StaticResource SecondaryText}"
                       Margin="0,6,0,0" />

            <!-- Журнал -->
            <TextBlock Text="{x:Static res:Strings.SettingsLogsHeader}" Style="{StaticResource SectionHeader}" />
            <Button Content="{x:Static res:Strings.SettingsOpenLogs}" Padding="16,8" HorizontalAlignment="Left"
                    Click="OnOpenLogsClick" />

            <!-- Каталог -->
            <TextBlock Text="{x:Static res:Strings.SettingsCatalogHeader}" Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="CatalogSourceText" Style="{StaticResource SecondaryText}" />
            <StackPanel x:Name="CatalogEditPanel" Margin="0,12,0,0">
                <TextBlock Text="{x:Static res:Strings.CatalogUrlHint}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.CatalogApply}"
                            Padding="16,6" Margin="12,0,0,0" Click="OnCatalogApplyClick" />
                    <TextBox x:Name="CatalogUrlBox" VerticalContentAlignment="Center" Padding="8,6" />
                </DockPanel>
                <TextBlock Text="{x:Static res:Strings.CatalogApplyNote}" Style="{StaticResource SecondaryText}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
