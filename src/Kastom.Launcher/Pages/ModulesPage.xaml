<UserControl x:Class="Kastom.Launcher.Pages.ModulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Kastom.Launcher.Resources"
             xmlns:shell="clr-namespace:Kastom.Launcher.Shell">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.NavModules}"
                   FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Шапка: перевірка оновлень і стан каталогу -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="{Binding CheckButtonText}" IsEnabled="{Binding CanCheck}"
                    Padding="16,8" VerticalAlignment="Center" Click="OnCheckClick" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastCheckText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding CatalogStatusText}" TextWrapping="Wrap" MaxWidth="720">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CatalogStatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Банер: потрібен перезапуск -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16,12" CornerRadius="6"
                Background="#40F2A900" BorderBrush="#80F2A900" BorderThickness="1"
                Visibility="{Binding ShowRestartBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Restart}"
                        Padding="16,6" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnRestartClick" />
                <TextBlock Text="{x:Static res:Strings.RestartBanner}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding LoadErrorText}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.NoModules}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="20,16" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding ChipBackground}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        </Border>
                                        <shell:ModuleIconView DockPanel.Dock="Left" Size="32" Margin="0,0,12,0"
                                                              Icon="{Binding Icon}" ModuleName="{Binding Name}"
                                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding VersionsText}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <ProgressBar Margin="0,12,0,0" Height="4" Minimum="0" Maximum="1"
                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="{x:Static res:Strings.ModuleSettingsButton}" Padding="16,7" Margin="0,0,8,0"
                                                Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnSettingsClick" />
                                        <Button Content="{Binding InstallText}" Padding="16,7" Margin="0,0,8,0"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnInstallClick" />
                                        <Button Content="{x:Static res:Strings.Update}" Padding="16,7" Margin="0,0,8,0"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnUpdateClick" />
                                        <Button Content="{Binding ToggleText}" Padding="16,7" Margin="0,0,8,0"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnToggleClick" />
                                        <Button Content="{Binding RollbackText}" Padding="16,7" Margin="0,0,8,0"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnRollbackClick" />
                                        <Button Content="{x:Static res:Strings.Uninstall}" Padding="16,7" Margin="0,0,8,0"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnUninstallClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
