<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Kastom.Sdk</RootNamespace>
    <!--
      Версія збірки SDK заморожена на весь контракт 1 і НЕ йде за версією лаунчера. Модуль посилається на SDK
      саме цієї версії, а лаунчер підставляє свою збірку SDK лише тоді, коли її версія не менша: «Звук» 1.2.0,
      зібраний, коли версія SDK ішла за лаунчером (0.1.3), не завантажився в лаунчері 0.1.2 («немає типу …»).
      0.1.3.0 — версія SDK у лаунчері 0.1.3, тож модулі, зібрані відтепер, потребують лаунчер 0.1.3 або новіший
      (minLauncherVersion у module.json). Міняється лише разом з KastomSdk.ContractVersion.
    -->
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
  </PropertyGroup>

</Project>
