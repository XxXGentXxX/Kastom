<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kastom.Sdk\Kastom.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Kastom.Core\Kastom.Core.csproj" />
    <!-- Демо-модуль збирається перед тестами; тести беруть його з папки збірки, а не підключають до себе. -->
    <ProjectReference Include="..\..\modules\Kastom.Modules.Demo\Kastom.Modules.Demo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DemoModuleOutput</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\modules\Kastom.Modules.Demo\bin\$(Configuration)\net10.0-windows\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
